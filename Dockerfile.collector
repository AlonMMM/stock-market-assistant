FROM node:24-bookworm-slim AS build
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci
COPY apps/collector apps/collector
COPY packages packages
RUN npm run build:collector

FROM node:24-bookworm-slim
ENV NODE_ENV=production COLLECTOR_HOST=0.0.0.0 PORT=3002 COLLECTOR_DB=/data/ibkr.sqlite
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci --omit=dev && mkdir /data && chown node:node /data
COPY --from=build /app/dist/collector.mjs ./collector.mjs
COPY config/ibkr-watchlist.json ./config/ibkr-watchlist.json
USER node
EXPOSE 3002
CMD ["node", "collector.mjs"]
