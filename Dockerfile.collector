FROM node:24-bookworm-slim AS build
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci
COPY apps/collector apps/collector
COPY packages packages
COPY config config
RUN npm run build:collector

FROM node:24-bookworm-slim
ENV NODE_ENV=production COLLECTOR_HOST=0.0.0.0 PORT=3002 COLLECTOR_DB=/data/alpaca.sqlite
WORKDIR /app
COPY package.json package-lock.json ./
RUN apt-get update && apt-get install -y --no-install-recommends gosu python3 python3-venv \
    && rm -rf /var/lib/apt/lists/* \
    && npm ci --omit=dev && mkdir /data && chown node:node /data
# technical-scan skill script for alert analysis (ANALYSIS_ENABLED=true).
COPY packages/analysis/technical-scan /app/technical-scan
RUN python3 -m venv /opt/technical-scan \
    && /opt/technical-scan/bin/pip install --no-cache-dir -r /app/technical-scan/requirements.txt
ENV TECHNICAL_SCAN_PYTHON=/opt/technical-scan/bin/python TECHNICAL_SCAN_SCRIPT=/app/technical-scan/analyze.py MPLCONFIGDIR=/tmp/matplotlib
COPY --from=build /app/dist/collector.mjs ./collector.mjs
COPY deploy/collector/start.sh /usr/local/bin/start-collector
RUN chmod +x /usr/local/bin/start-collector
EXPOSE 3002
CMD ["start-collector"]
