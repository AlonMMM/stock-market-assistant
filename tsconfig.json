{
  "compilerOptions": {
    "target": "ES2023",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": ["node"]
  },
  "include": [
    "apps/api/src/**/*.ts",
    "packages/**/*.ts",
    "tests/**/*.ts",
    "playwright.config.ts",
    "apps/collector/src/**/*.ts"
  ]
}
