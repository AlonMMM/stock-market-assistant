FROM ubuntu:24.04

ENV DEBIAN_FRONTEND=noninteractive DISPLAY=:99

RUN apt-get update && apt-get install -y --no-install-recommends \
    apache2-utils ca-certificates curl fluxbox nginx novnc websockify x11vnc xvfb \
    fonts-dejavu-core libasound2t64 libglib2.0-0 libgtk-3-0 libnss3 libxi6 libxrender1 libxtst6 \
    && rm -rf /var/lib/apt/lists/*

# Official vendor installer. Brokerage credentials are entered interactively
# inside IB Gateway and are never supplied to this image or start script.
RUN curl --fail --location --retry 3 \
    https://download2.interactivebrokers.com/installers/ibgateway/stable-standalone/ibgateway-stable-standalone-linux-x64.sh \
    -o /tmp/gateway.sh \
    && chmod +x /tmp/gateway.sh \
    && /tmp/gateway.sh -q -dir /opt/ibgateway \
    && rm /tmp/gateway.sh

RUN useradd --create-home gateway && chown -R gateway:gateway /opt/ibgateway
COPY deploy/gateway/start.sh /usr/local/bin/start-gateway
RUN chmod +x /usr/local/bin/start-gateway

EXPOSE 8080 4001 4002
CMD ["/usr/local/bin/start-gateway"]
