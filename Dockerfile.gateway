FROM ubuntu:24.04
ENV DEBIAN_FRONTEND=noninteractive DISPLAY=:99
RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates curl xvfb fluxbox x11vnc novnc websockify nginx apache2-utils \
    libxtst6 libxrender1 libxi6 libglib2.0-0 libgtk-3-0 libnss3 libasound2t64 fonts-dejavu-core \
    && rm -rf /var/lib/apt/lists/*
# Official vendor installer; no third-party image receives brokerage credentials.
RUN curl --fail --location --retry 3 \
    https://download2.interactivebrokers.com/installers/ibgateway/stable-standalone/ibgateway-stable-standalone-linux-x64.sh \
    -o /tmp/gateway.sh && chmod +x /tmp/gateway.sh \
    && /tmp/gateway.sh -q -dir /opt/ibgateway && rm /tmp/gateway.sh
RUN useradd --create-home --uid 1000 gateway && chown -R gateway:gateway /opt/ibgateway
COPY deploy/gateway/start.sh /usr/local/bin/start-gateway
RUN chmod +x /usr/local/bin/start-gateway
EXPOSE 8080
CMD ["/usr/local/bin/start-gateway"]
