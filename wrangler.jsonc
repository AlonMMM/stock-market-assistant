// Cloudflare Worker for the website and its API (apps/api/src/worker.ts).
// The long-running collector is deployed separately (Dockerfile.collector).
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "stock-market-assistant",
  "main": "dist/server/index.js",
  "compatibility_date": "2026-09-01",
  "build": { "command": "npm run build" },
  // Preview URLs are not covered by the Access application; keep them off.
  "preview_urls": false,
  "vars": {
    // From the Zero Trust Access application. The Worker rejects
    // every request (401) whose Access token does not match these values.
    "ACCESS_TEAM_DOMAIN": "https://broad-boat-f733.cloudflareaccess.com",
    "ACCESS_AUD": "ee019b5ddf9a5fc866f8105dde682c0374984712fa029b47361642d5c0967586",
    // Railway collector; requests carry the COLLECTOR_TOKEN secret.
    "COLLECTOR_URL": "https://market-collector-production-b05d.up.railway.app",
    // Minutes SIP data lags real time: 0 with real-time SIP (Algo Trader
    // Plus); "15" on Alpaca's free plan. See docs/alpaca-operations.md.
    "ALPACA_SIP_DELAY_MINUTES": "0",
  },
  // Cache of Alpaca minute bars per symbol and day (backtests, day charts).
  "d1_databases": [
    {
      "binding": "BARS_CACHE",
      "database_name": "sma-bars-cache",
      "database_id": "c3eec64d-d164-4632-8049-5f7b6e74b75a",
    },
  ],
  // The Backtest page's runs (packages/market-data/src/backtest-jobs.ts): each
  // part of a run is a message, consumed by this Worker one at a time, 4 at
  // once (as the page ran them), so a run goes on when the phone leaves the
  // page. Create the queue once before the first deploy:
  //   npx wrangler queues create sma-backtest-parts
  "queues": {
    "producers": [
      { "binding": "BACKTEST_QUEUE", "queue": "sma-backtest-parts" },
    ],
    "consumers": [
      {
        "queue": "sma-backtest-parts",
        "max_batch_size": 1,
        "max_batch_timeout": 1,
        "max_concurrency": 4,
        "max_retries": 3,
      },
    ],
  },
  // Every minute: check that the trading account is not short an option and
  // tell the trades channel if it is (packages/trading/src/watch.ts); then
  // send the user's price alerts that are met (price-alerts.ts), to
  // PRICE_ALERTS_TELEGRAM_BOT_TOKEN / _CHAT_ID when set, else the trades
  // channel. An optional SITE_URL var adds a link to the stock's page.
  "triggers": { "crons": ["* * * * *"] },
  // ALPACA_API_KEY, ALPACA_API_SECRET, COLLECTOR_TOKEN, and for the check
  // above TRADES_TELEGRAM_BOT_TOKEN and TRADES_TELEGRAM_CHAT_ID, are Worker
  // secrets:
  //   npx wrangler secret put ALPACA_API_KEY
}
