# Configure these in the cloud secret manager; never commit real credentials.
IBKR_HOST=127.0.0.1
IBKR_PORT=4001
# Must match Gateway's "Send market data in lots" setting.
IBKR_VOLUME_UNIT=shares
# Generate a random secret, at least 32 characters. No IBKR password belongs here.
COLLECTOR_TOKEN=
COLLECTOR_DB=data/local/ibkr.sqlite
COLLECTOR_HOST=127.0.0.1
PORT=3002
