# Configure real values only in the cloud secret manager or an ignored local file.
ALPACA_API_KEY=
ALPACA_API_SECRET=
# IEX works with basic market-data access. Use SIP only with the matching plan.
ALPACA_FEED=iex
ALPACA_ENABLED=false
# Optional comma-separated override for staged validation, e.g. AAPL.
ALPACA_SYMBOLS=
# Generate a random secret of at least 32 characters for the collector HTTP API.
COLLECTOR_TOKEN=
COLLECTOR_DB=data/local/alpaca.sqlite
COLLECTOR_HOST=127.0.0.1
PORT=3002
